# ============================================
# KSAI EXAM PLATFORM - Git Ignore
# ============================================

# Environment and Credentials
.env
.env.local
.env.production
.env.deployment.credentials
*.credentials
deployment-info.txt
*.pem
*.key

# Allow template files
!.env.example
!.env.*.template

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.turbo/

# IDEs and Editors
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating System
.DS_Store
Thumbs.db
desktop.ini

# Build directories
build/
dist/

# Test files (DO NOT COMMIT)
test_*.py
check_*.py
*_test.py

# Deployment scripts (DO NOT COMMIT)
deploy_*.py
deploy_*.sh
deployment_*.py
simple_*.py
update_*.py
cleanup_*.py
force_*.py
reprocess_*.py
process_*.py

# Temporary files and directories
temp/
temp_*/
tmp/
*.tmp
*.bak
nul

# Test data and documents
TESTDOC/
test_doc/
doc/
pastpaper/
MEMORY_BANK*.md
DEPLOYMENT*.txt
EMBEDDING*.md

# Database files
*.db
*.sqlite
*.sqlite3

# Uploaded content (should be on server/S3, not in repo)
uploads/
*.pdf
*.docx
*.xlsx

# Compiled files
*.pyc
*.pyo

# Logs
*.log
logs/

# Archives
*.tar
*.tar.gz
*.zip
*.rar

# Coverage reports
coverage/
test-results/
.coverage.*

# Vercel
.vercel

# Alembic
apps/api/alembic/versions/*.pyc

# Lock files (keep package-lock.json and pnpm-lock.yaml)
yarn.lock
